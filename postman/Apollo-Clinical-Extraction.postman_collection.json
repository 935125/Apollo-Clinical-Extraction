              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": {{patientA_prevVersion}},\n  \"text\": \"Chief Complaint:\\n{{postmanRunTag}} Outpatient follow-up for hypertension, diabetes, and dyslipidaemia.\\n\\nCurrent Medications:\\nContinue Amlodipine 5 mg 1 tablet orally once daily for 30 days.\\nDiscontinue Warfarin 5 mg immediately due to elevated INR.\\nAmoxicillin was discussed but not prescribed.\\n\\nPlan:\\nStart Metformin 500 mg half tablet orally twice daily for 14 days.\\nTake Paracetamol 650 mg 1 tablet orally as needed for fever.\\n\\nInvestigations:\\nPrevious HbA1c was normal last month.\\nOrder Complete Blood Count and Serum Creatinine tomorrow morning.\\nOrder Liver Function Tests and 12-lead ECG today.\\nOrder Chest X-ray PA view if cough persists beyond 48 hours.\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/emr/notes/{{patientA_noteId}}/corrections"
