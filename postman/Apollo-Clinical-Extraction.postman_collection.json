    {
      "name": "4. Asynchronous Processing",
      "item": [
        {
          "name": "4.1 Poll Extraction Status Until Terminal State (Bounded)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/queue/{{patientA_noteId}}?version={{signedVersion}}&patient={{patientA_ref}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempt = Number(pm.environment.get('pollAttempt') || '0');",
                  "const delay = Number(pm.environment.get('pollIntervalMs') || '2000');",
                  "if (attempt > 0) {",
                  "  setTimeout(function () {}, delay);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.response || !pm.response.code) { pm.test('BLOCKED: Backend API unreachable', () => pm.expect.fail('BLOCKED: Backend API unreachable')); return; }",
                  "const body = pm.response.json();",
                  "const attempt = Number(pm.environment.get('pollAttempt') || '0');",
                  "const maxAttempts = Number(pm.environment.get('maxPollAttempts') || '15');",
                  "const inProgress = ['Waiting', 'Queued', 'Extracting'].includes(body.queueState);",
                  "if (inProgress && attempt < maxAttempts) {",
                  "  pm.environment.set('pollAttempt', String(attempt + 1));",
                  "  if (pm.execution && typeof pm.execution.setNextRequest === 'function') {",
                  "    pm.execution.setNextRequest('4.1 Poll Extraction Status Until Terminal State (Bounded)');",
                  "  } else if (typeof postman !== 'undefined' && typeof postman.setNextRequest === 'function') {",
                  "    postman.setNextRequest('4.1 Poll Extraction Status Until Terminal State (Bounded)');",
                  "  }",
                  "  return;",
                  "}",
                  "pm.environment.set('pollAttempt', '0');",
                  "pm.test('Asynchronous worker completed extraction within bounded timeout', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.queueState, 'Final queue state (error=' + (body.error || 'none') + ')').to.eql('Ready');",
                  "  pm.expect(body.eventId).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.extractionId).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.extraction).to.be.an('object');",
                  "  pm.expect(body.extraction.correlationId).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.sourceHash).to.have.lengthOf(64);",
                  "  pm.environment.set('patientA_eventId', body.eventId);",
                  "  pm.environment.set('patientA_extractionId', body.extractionId);",
                  "  pm.environment.set('patientA_correlationId', body.extraction.correlationId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Retrieve Persisted Extraction by Extraction ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/extractions/{{patientA_extractionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.response || !pm.response.code) { pm.test('BLOCKED: Backend API unreachable', () => pm.expect.fail('BLOCKED: Backend API unreachable')); return; }",
                  "pm.test('Persisted extraction matches extractionId and correlationId', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const ext = pm.response.json();",
                  "  pm.expect(ext.extractionId).to.eql(pm.environment.get('patientA_extractionId'));",
                  "  pm.expect(ext.correlationId).to.eql(pm.environment.get('patientA_correlationId'));",
                  "  pm.expect(ext.saved).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Export FHIR R4 Bundle for Completed Extraction",
          "request": {
            "method": "GET",
