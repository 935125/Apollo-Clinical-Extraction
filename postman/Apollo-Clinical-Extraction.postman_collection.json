                "exec": [
                  "if (!pm.response || !pm.response.code) { pm.test('BLOCKED: Backend API unreachable', () => pm.expect.fail('BLOCKED: Backend API unreachable')); return; }",
                  "const body = pm.response.json();",
                  "const invs = (body.extraction && body.extraction.investigations) || [];",
                  "const findInv = (rx) => invs.find(i => rx.test(i.name || ''));",
                  "pm.test('Investigations extracted with verified source evidence', function () {",
                  "  pm.expect(invs.length).to.be.at.least(3);",
                  "  invs.forEach(i => {",
                  "    pm.expect(i.evidence && i.evidence.quote).to.be.a('string').and.not.empty;",
                  "    pm.expect(i.evidence.verified).to.eql(true);",
                  "  });",
                  "});",
                  "pm.test('Complete Blood Count carries LOINC 58410-2 exact or narrower withheld candidate', function () {",
                  "  const cbc = findInv(/complete blood count|\\bcbc\\b/i);",
                  "  pm.expect(cbc, 'Complete Blood Count must be extracted').to.be.an('object');",
                  "  const code = (cbc.normalization && (cbc.normalization.matchedCode || cbc.normalization.candidateCode)) || '';",
                  "  pm.expect(code).to.eql('58410-2');",
                  "});",
                  "pm.test('Serum Creatinine and ECG/LFT extracted cleanly', function () {",
                  "  pm.expect(findInv(/creatinine/i), 'Serum Creatinine must be extracted').to.be.an('object');",
                  "  pm.expect(findInv(/ecg|electrocardiogram/i), 'ECG must be extracted').to.be.an('object');",
                  "  pm.expect(findInv(/liver function|lft/i), 'Liver Function Tests must be extracted').to.be.an('object');",
                  "});",
                  "pm.test('Conditional Chest X-ray preserves conditional assertion status', function () {",
                  "  const cxr = findInv(/chest x-?ray/i);",
                  "  pm.expect(cxr, 'Chest X-ray must be extracted').to.be.an('object');",
                  "  pm.expect(cxr.assertionStatus).to.eql('conditional');",
                  "});",
                  "pm.test('Historical HbA1c is not misrepresented as a new order', function () {",
                  "  const a1c = findInv(/hba1c/i);",
                  "  if (a1c) {",
                  "    pm.expect(a1c.assertionStatus).to.eql('historical');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
