    {
      "name": "5. Medication Extraction",
      "item": [
        {
          "name": "5.1 Verify Medication Assertions, Strength/Dose Separation & Source Evidence",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/queue/{{patientA_noteId}}?version={{signedVersion}}&patient={{patientA_ref}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.response || !pm.response.code) { pm.test('BLOCKED: Backend API unreachable', () => pm.expect.fail('BLOCKED: Backend API unreachable')); return; }",
                  "const body = pm.response.json();",
                  "const meds = (body.extraction && body.extraction.medications) || [];",
                  "const findMed = (name) => meds.find(m => (m.name || '').toLowerCase().includes(name.toLowerCase()));",
                  "pm.test('Medications extracted with verified source evidence', function () {",
                  "  pm.expect(meds.length).to.be.at.least(3);",
                  "  meds.forEach(m => {",
                  "    pm.expect(m.evidence && m.evidence.quote).to.be.a('string').and.not.empty;",
                  "    pm.expect(m.evidence.verified).to.eql(true);",
                  "  });",
                  "});",
                  "pm.test('Amlodipine continued/current with strength 5 mg and administered dose 1 tablet', function () {",
                  "  const amlo = findMed('Amlodipine');",
                  "  pm.expect(amlo, 'Amlodipine must be extracted').to.be.an('object');",
                  "  pm.expect(amlo.strength).to.eql('5 mg');",
                  "  pm.expect(amlo.dose).to.eql('1 tablet');",
                  "  pm.expect(['current_medication', 'continued']).to.include(amlo.assertionStatus);",
                  "});",
                  "pm.test('Metformin new order with strength 500 mg and administered dose half tablet', function () {",
                  "  const met = findMed('Metformin');",
                  "  pm.expect(met, 'Metformin must be extracted').to.be.an('object');",
                  "  pm.expect(met.strength).to.eql('500 mg');",
                  "  pm.expect(met.dose).to.eql('half tablet');",
                  "  pm.expect(met.assertionStatus).to.eql('new_order');",
                  "});",
                  "pm.test('Warfarin accurately marked Discontinued (not active prescription)', function () {",
                  "  const warf = findMed('Warfarin');",
                  "  pm.expect(warf, 'Warfarin must be extracted').to.be.an('object');",
                  "  pm.expect(warf.assertionStatus).to.eql('discontinued');",
                  "});",
                  "pm.test('Negated Amoxicillin is not recorded as an active new_order prescription', function () {",
                  "  const amox = findMed('Amoxicillin');",
                  "  if (amox) {",
                  "    pm.expect(amox.assertionStatus).to.not.eql('new_order');",
                  "    pm.expect(amox.assertionStatus).to.not.eql('current_medication');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Investigation Extraction",
      "item": [
        {
          "name": "6.1 Verify Investigations, Order Intent, Conditionality & Terminology",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/queue/{{patientA_noteId}}?version={{signedVersion}}&patient={{patientA_ref}}"
          },
          "event": [
            {
              "listen": "test",
