<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Apollo.Backend</AssemblyName>
    <RootNamespace>Apollo.Backend</RootNamespace>
    <UserSecretsId>Apollo-AIExtraction-Local</UserSecretsId>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs;artifacts\**;contracts\**;db\**;docs\**;infra\**;logs\**;tools\**;.integration-postgres\**" />
    <Content Remove="tests\**\*;artifacts\**;contracts\**;db\**;docs\**;infra\**;logs\**;tools\**;.integration-postgres\**" />
    <EmbeddedResource Remove="tests\**\*;artifacts\**;contracts\**;db\**;docs\**;infra\**;logs\**;tools\**;.integration-postgres\**" />
    <None Remove="tests\**\*;artifacts\**;contracts\**;db\**;docs\**;infra\**;logs\**;tools\**;.integration-postgres\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Clinical\terminology-verification.json" />
    <EmbeddedResource Include="db\platform\migrations\V0009__doctor_emr.sql" />
  </ItemGroup>

</Project>

