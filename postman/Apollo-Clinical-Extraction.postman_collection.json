{
  "info": {
    "name": "Apollo Clinical Extraction — Backend API Verification Suite",
    "description": "Headless end-to-end Postman Collection v2.1 verifying Infrastructure, Authentication, Clinical Note Ingestion, Asynchronous Service Bus Processing, Medication & Investigation Extraction, UHID/Patient Isolation, Provider Routing, and Idempotency on ASP.NET Core .NET 10 without Angular.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
