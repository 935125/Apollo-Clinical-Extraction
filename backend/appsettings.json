{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http5000": {
        "Url": "http://127.0.0.1:5000"
      },
      "Http8000": {
        "Url": "http://127.0.0.1:8000"
      }
    }
  },
  "LocalOnnx": {
    "PipelineVersion": "Legacy",
    "TimeoutSeconds": 30
  },
  "Extraction": {
    "Provider": "MicrosoftFoundry",
    "FallbackProvider": "LocalOnnx",
    "AllowDirectLocal": false
  },
  "Persistence": {
    "AutoMigrate": false
  },
  "Foundry": {
    "Endpoint": "",
    "DeploymentName": "",
    "AuthenticationMode": "EntraId",
    "TimeoutSeconds": 45,
    "MaxRetries": 2,
    "MaxCompletionTokens": 16000,
    "AllowLocalFallback": true,
    "TargetModel": "gpt-6.1-sol",
    "AllowParsingFallback": false,
    "CircuitFailureThreshold": 5,
    "CircuitBreakSeconds": 30
  },
  "Security": {
    "LocalDemoMode": false,
    "SyntheticData": {
      "AllowAuthorizedSyntheticIdentifiers": false,
      "AllowExternalFoundryForVerifiedSynthetic": false,
      "AllowedPatientReferences": []
    },
    "Authority": "",
    "Audience": "",
    "RequestsPerMinute": 240,
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "http://localhost:5000",
      "http://127.0.0.1:5000",
      "http://localhost:8000",
      "http://127.0.0.1:8000"
    ]
  }
}
