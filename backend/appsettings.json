{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http5000": {
        "Url": "http://127.0.0.1:5000"
      },
      "Http8000": {
        "Url": "http://127.0.0.1:8000"
      }
    }
  },
  "Extraction": {
    "Provider": "LocalOnnx",
    "FallbackProvider": "LocalOnnx"
  },
  "Persistence": {
    "AutoMigrate": false
  },
  "Foundry": {
    "Endpoint": "",
    "DeploymentName": "",
    "AuthenticationMode": "EntraId",
    "TimeoutSeconds": 45,
    "MaxRetries": 2,
    "MaxCompletionTokens": 16000,
    "AllowLocalFallback": true
  },
  "Security": {
    "LocalDemoMode": false,
    "Authority": "",
    "Audience": "",
    "RequestsPerMinute": 240,
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200",
      "http://localhost:5000",
      "http://127.0.0.1:5000",
      "http://localhost:8000",
      "http://127.0.0.1:8000"
    ]
  }
}
