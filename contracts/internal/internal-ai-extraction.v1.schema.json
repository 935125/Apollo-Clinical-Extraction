{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-extraction.platform/contracts/internal/internal-ai-extraction.v1.schema.json",
  "title": "InternalAiExtractionPayloadV1",
  "description": "Versioned synchronous HTTP contract between ASP.NET Core Public API Gateway and Internal Python AI Extraction Service.",
  "type": "object",
  "required": [
    "schemaVersion",
    "correlationId",
    "medications",
    "investigations",
    "validationSummary",
    "executionDurationMs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "correlationId": {
      "type": "string"
    },
    "preprocessed": {
      "type": "object",
      "required": ["charLength", "sections"],
      "properties": {
        "charLength": { "type": "integer" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "heading", "start", "end"],
            "properties": {
              "code": { "type": "string" },
              "heading": { "type": "string" },
              "start": { "type": "integer" },
              "end": { "type": "integer" }
            }
          }
        }
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "assertionStatus", "evidence", "qualityFlags", "writebackEligible"],
        "properties": {
          "name": { "type": "string" },
          "strength": { "type": ["string", "null"] },
          "dose": { "type": ["string", "null"] },
          "route": { "type": ["string", "null"] },
          "frequency": { "type": ["string", "null"] },
          "duration": { "type": ["string", "null"] },
          "formulation": { "type": ["string", "null"] },
          "instructions": { "type": ["string", "null"] },
          "assertionStatus": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["quote", "verified", "start", "end"],
            "properties": {
              "quote": { "type": "string" },
              "verified": { "type": "boolean" },
              "start": { "type": ["integer", "null"] },
              "end": { "type": ["integer", "null"] }
            }
          },
          "qualityFlags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "severity", "message"],
              "properties": {
                "code": { "type": "string" },
                "severity": { "type": "string" },
                "field": { "type": ["string", "null"] },
                "message": { "type": "string" }
              }
            }
          },
          "writebackEligible": { "type": "boolean" }
        }
      }
    },
    "investigations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "assertionStatus", "evidence", "qualityFlags", "writebackEligible"],
        "properties": {
          "name": { "type": "string" },
          "testType": { "type": ["string", "null"] },
          "specimen": { "type": ["string", "null"] },
          "assertionStatus": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["quote", "verified", "start", "end"],
            "properties": {
              "quote": { "type": "string" },
              "verified": { "type": "boolean" },
              "start": { "type": ["integer", "null"] },
              "end": { "type": ["integer", "null"] }
            }
          },
          "qualityFlags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "severity", "message"],
              "properties": {
                "code": { "type": "string" },
                "severity": { "type": "string" },
                "field": { "type": ["string", "null"] },
                "message": { "type": "string" }
              }
            }
          },
          "writebackEligible": { "type": "boolean" }
        }
      }
    },
    "validationSummary": {
      "type": "object",
      "required": ["hasErrors", "errorCount", "warningCount"],
      "properties": {
        "hasErrors": { "type": "boolean" },
        "errorCount": { "type": "integer" },
        "warningCount": { "type": "integer" }
      }
    },
    "executionDurationMs": {
      "type": "number"
    }
  }
}

