          "name": "3.1 Discover Assigned Encounters (GET /api/v1/emr/encounters)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/emr/encounters"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.response || !pm.response.code) { pm.test('BLOCKED: Backend API unreachable', () => pm.expect.fail('BLOCKED: Backend API unreachable')); return; }",
                  "pm.test('Assigned synthetic encounters P100234 and P100237 discovered', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const list = pm.response.json();",
                  "  pm.expect(list).to.be.an('array').and.not.empty;",
                  "  const encA = list.find(e => e.patientReference === pm.environment.get('patientA_ref'));",
                  "  const encB = list.find(e => e.patientReference === pm.environment.get('patientB_ref'));",
                  "  pm.expect(encA, 'Assigned encounter for P100234 must exist').to.be.an('object');",
                  "  pm.expect(encB, 'Assigned encounter for P100237 must exist').to.be.an('object');",
                  "  pm.environment.set('patientA_noteId', encA.noteId);",
                  "  pm.environment.set('patientA_prevVersion', String(encA.version));",
                  "  pm.environment.set('patientB_noteId', encB.noteId);",
                  "  pm.environment.set('postmanRunTag', 'POSTMAN-E2E-' + Date.now());",
                  "});"
                ]
              }
            }
          ]
        },
