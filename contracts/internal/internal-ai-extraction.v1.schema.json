{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-extraction.platform/contracts/internal/internal-ai-extraction.v1.schema.json",
  "title": "InternalAiExtractionPayloadV1",
  "description": "Versioned synchronous HTTP contract between ASP.NET Core Public API Gateway and Internal Python AI Extraction Service.",
  "type": "object",
  "required": [
    "schemaVersion",
    "correlationId",
    "medications",
    "investigations",
    "validationSummary",
    "executionDurationMs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "correlationId": {
      "type": "string"
    },
    "modelMetadata": {
      "type": "object",
      "properties": {
        "adapterType": { "type": "string" },
        "modelDeployment": { "type": "string" },
        "promptVersion": { "type": "string" }
      }
    },
    "preprocessed": {
      "type": "object",
      "required": ["charLength", "sections"],
      "properties": {
        "charLength": { "type": "integer" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "heading", "start", "end"],
            "properties": {
              "code": { "type": "string" },
              "heading": { "type": "string" },
              "start": { "type": "integer", "description": "UTF-16 start offset" },
              "end": { "type": "integer", "description": "UTF-16 end offset" }
            }
          }
        }
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "assertionStatus", "evidence", "qualityFlags", "normalization"],
        "properties": {
          "name": { "type": "string" },
          "strength": { "type": ["string", "null"] },
          "dose": { "type": ["string", "null"] },
          "route": { "type": ["string", "null"] },
          "frequency": { "type": ["string", "null"] },
          "duration": { "type": ["string", "null"] },
          "formulation": { "type": ["string", "null"] },
          "instructions": { "type": ["string", "null"] },
          "assertionStatus": {
            "type": "string",
            "enum": ["new_order", "current_medication", "historical", "discontinued", "negated", "suggested", "conditional", "uncertain"]
          },
          "evidence": {
            "type": "object",
            "required": ["quote", "verified", "start", "end"],
            "properties": {
              "quote": { "type": "string" },
              "verified": { "type": "boolean" },
              "start": { "type": ["integer", "null"], "description": "0-based UTF-16 code unit start offset" },
              "end": { "type": ["integer", "null"], "description": "0-based UTF-16 code unit end offset" }
            }
          },
          "normalization": {
            "type": "object",
            "required": ["status", "confidence"],
            "properties": {
              "status": { "type": "string", "enum": ["exact_match", "synonym_match", "fuzzy_match", "ambiguous", "unresolved"] },
              "matchedCode": { "type": ["string", "null"] },
              "displayName": { "type": ["string", "null"] },
              "confidence": { "type": "number" }
            }
          },
          "qualityFlags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "severity", "message"],
              "properties": {
                "code": { "type": "string" },
                "severity": { "type": "string" },
                "field": { "type": ["string", "null"] },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "investigations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "assertionStatus", "evidence", "qualityFlags", "normalization"],
        "properties": {
          "name": { "type": "string" },
          "timing": { "type": ["string", "null"] },
          "specimen": { "type": ["string", "null"] },
          "assertionStatus": {
            "type": "string",
            "enum": ["new_order", "historical", "negated", "suggested", "conditional", "uncertain"]
          },
          "evidence": {
            "type": "object",
            "required": ["quote", "verified", "start", "end"],
            "properties": {
              "quote": { "type": "string" },
              "verified": { "type": "boolean" },
              "start": { "type": ["integer", "null"], "description": "0-based UTF-16 code unit start offset" },
              "end": { "type": ["integer", "null"], "description": "0-based UTF-16 code unit end offset" }
            }
          },
          "normalization": {
            "type": "object",
            "required": ["status", "confidence"],
            "properties": {
              "status": { "type": "string", "enum": ["exact_match", "synonym_match", "fuzzy_match", "ambiguous", "unresolved"] },
              "matchedCode": { "type": ["string", "null"] },
              "displayName": { "type": ["string", "null"] },
              "confidence": { "type": "number" }
            }
          },
          "qualityFlags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "severity", "message"],
              "properties": {
                "code": { "type": "string" },
                "severity": { "type": "string" },
                "field": { "type": ["string", "null"] },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "validationSummary": {
      "type": "object",
      "required": ["hasErrors", "errorCount", "warningCount"],
      "properties": {
        "hasErrors": { "type": "boolean" },
        "errorCount": { "type": "integer" },
        "warningCount": { "type": "integer" }
      }
    },
    "executionDurationMs": {
      "type": "number"
    }
  }
}
